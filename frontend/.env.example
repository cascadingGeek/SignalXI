# Copy to frontend/.env.local for local runs. Production values live in Vercel.
# NEXT_PUBLIC_* values are public: they ship in the browser bundle.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Unset in Vercel Preview, so previews render without API data.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Local values come from `supabase status` (API URL and anon key). Production only in Vercel.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# local | preview | production (unset = production). /dev/ui is served only outside production.
NEXT_PUBLIC_APP_ENV=local
# Reserve ad slots (true | false). Keep false in production until the ad network spec lands.
NEXT_PUBLIC_ADS_ENABLED=false
