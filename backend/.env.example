# Copy to backend/.env for local runs. Values below match `supabase start` and `docker compose up`.
# Production values live in the Render dashboard (see render.yaml), never in git.

APP_ENV=local
# Local: direct Postgres from `supabase start` (port 54322).
# Production: Supavisor session mode, port 5432, user postgres.<project-ref>, SSL is forced by APP_ENV.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
REDIS_URL=redis://127.0.0.1:6379/0
SUPABASE_URL=http://127.0.0.1:54321
CORS_ALLOWED_ORIGINS=http://localhost:3000
